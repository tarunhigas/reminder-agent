# Reminder Agent — Python/FastAPI Configuration
# Copy this file to `.env` and fill in your values:
#     cp .env.sample .env

# ── Web server ───────────────────────────────────────────────────────
# Port the app listens on. Open http://localhost:<PORT>
PORT=3002

# ── Reminder timing ──────────────────────────────────────────────────
# First ("early") reminder — this many minutes before a task starts
REMINDER_LEAD_TIME_MINUTES=15

# Second ("urgent") reminder — this many minutes before a task starts
REMINDER_URGENT_MINUTES=5

# ── Storage ──────────────────────────────────────────────────────────
# Where tasks are saved (relative to project root)
DB_PATH=./data/tasks.json

# ── Scheduling ───────────────────────────────────────────────────────
# Minimum gap (minutes) required between two tasks before they clash
MIN_GAP_MINUTES=10

# ── Desktop notifications ────────────────────────────────────────────
# Show OS-level popup notifications (true/false)
DESKTOP_NOTIFICATIONS=true

# ── Slack notifications ──────────────────────────────────────────────
# 1. Create an app at https://api.slack.com/apps (From scratch)
# 2. Enable "Incoming Webhooks", add one to a channel, copy the URL
# 3. Set SLACK_NOTIFICATIONS=true and paste the URL below
SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ── Logging ──────────────────────────────────────────────────────────
# Log verbosity: info | debug
LOG_LEVEL=info
